p([Z(),q("design:type",Object)],T$.prototype,"itemTitle",void 0);p([Z({type:Array}),q("design:type",Array)],T$.prototype,"description",void 0);p([Z({type:Boolean,reflect:!0}),q("design:type",Object)],T$.prototype,"expanded",void 0);p([Z({type:Boolean,reflect:!0}),q("design:type",Object)],T$.prototype,"highlight",void 0);p([LM("colab-signup-faq-item")],T$);function hZc(a){var b=L_(),c=new br(m$.PRO_NOTEBOOK.replace("/v2/external",""));JR(c.queryData_);var d=c.toString();a=a.manageSubscriptionUrl||"https://payments.google.com";c="You may cancel your subscription any time at "+cl(HN,"a",{href:a})+"payments.google.com"+el(HN,"a")+" under Subscriptions & services. After cancellation, your "+IN+" or "+KN+" benefits will continue to be available to you until a month after your final payment.";var e="Please verify that you are using the correct Google account and payments profile on "+
cl(HN,"a",{href:a})+"payments.google.com"+el(HN,"a")+" in order to be able to see and cancel your subscription.",f="Except in cases provided for by law (e.g. exercise of your right of withdrawal), compute units purchased from "+JN+" or granted via "+IN+" or "+KN+" are not refundable and not transferable, and expire after 90 days.",g="If you have a subscription through a "+cl(HN,"strong")+"Workspace organization"+el(HN,"strong")+", you will need to contact your Workspace administrator to make changes. They can update your subscription status at "+
cl(HN,"a",{href:"https://admin.google.com",target:"_blank"})+"admin.google.com"+el(HN,"a");c={hash:"cancel",itemTitle:"How can I cancel Colab purchases?",description:[HN.format(c),HN.format(e),f,HN.format(g)]};e={hash:"timeout",itemTitle:"How long can notebooks run in Colab?",description:["Colab prioritizes interactive compute. Runtimes will time out if you are idle.","In the version of Colab that is free of charge notebooks can run for at most 12 hours, depending on availability and your usage patterns. "+
IN+" and "+JN+" offer you increased compute availability based on your compute unit balance.",KN+" offers background execution which supports continuous code execution for up to 24 hours. Idle timeouts only apply if code execution terminates."]};f={hash:"background",itemTitle:"What is \u201cbackground execution\u201d?",description:["Pro+ users with a positive Colab compute unit balance automatically have background execution enabled for their notebooks, causing execution to continue after the browser closes up to a maximum runtime limit of up to 24 hours. Background execution only applies during an execution state: idle times will still result in VM deletion. Your output will be saved to Drive after the completion of each cell execution, even if your browser is closed. Resources are not guaranteed and usage limits still apply.",
IN+" users will see extended execution times and saving of output to Drive based on availability.","Users without a paid subscription should not rely on execution to continue in the background; execution will be interrupted when user interaction ceases, and the VM will be deleted soon after that."]};g="Consider closing your Colab tabs or disconnecting from your runtime when you are done working and avoid utilizing GPUs when it is unnecessary for your work. This will make it less likely that you will run into usage limits within Colab. You can always "+
cl(HN,"a",{href:b,target:"_blank"})+"purchase more compute"+el(HN,"a")+" via "+JN+" should you hit limits.";d="For more information on getting the most out of the paid version of Colab, see "+cl(HN,"a",{href:d,target:"_blank"})+"Making the Most of your Colab Subscription"+el(HN,"a")+".";d={hash:"advantage",itemTitle:"How can I get the most out of Colab?",description:[HN.format(g),HN.format(d)]};g={hash:"upgrade",itemTitle:"How does upgrading from "+IN+" to "+KN+" work?",description:["Your billing renewal date will remain the same, and the charge for your first month will be prorated as described below. Subsequent renewals will be at the full monthly price (shown above).",
"Your initial charge will be less than the full monthly price if you are upgrading from "+IN+". Specifically, it will reflect a prorated charge for "+KN+", as well as a prorated credit for your most recent payment for "+IN+".","For example, if there is only \u2153 of the month left in your current billing cycle when you upgrade to "+KN+", then the amount you will be charged when you upgrade will be \u2153 of the full price of a "+KN+" subscription, minus \u2153 the monthly price of "+IN+" (a discount reflecting the fact that you already paid for your "+
IN+" subscription at the beginning of the billing cycle).","The exact amount of your first monthly charge will be shown to you before your purchase is finalized. Subsequent months will renew at the full monthly price shown above.","There are no prorated refunds if you later cancel your subscription to "+KN+".","There is also no way to downgrade from "+KN+" to "+IN+" (although you can cancel "+KN+" and then re-subscribe to "+IN+" once your pre-paid month of "+KN+" has lapsed.)"]};var h="How can I downgrade from "+
KN+" to "+IN+"?";b="Unfortunately, the only way to downgrade is by canceling "+KN+" at "+cl(HN,"a",{href:a})+"payments.google.com"+el(HN,"a")+", then subscribing to "+IN+" at "+cl(HN,"a",{href:b})+"colab.research.google.com/signup"+el(HN,"a")+".";b=HN.format(b);return[c,{hash:"gpu",itemTitle:"What kinds of GPUs are available in Colab?",description:["In the version of Colab that is free of charge there is very limited access to GPUs. Usage limits are much lower than they are in paid versions of Colab.",
"With paid versions of Colab you are able to upgrade to powerful premium GPUs subject to availability and your compute unit balance. The types of GPUs available will vary over time."]},e,{hash:"memory",itemTitle:"How much memory is available in Colab?",description:["In the version of Colab that is free of charge you are able to access VMs with a standard system memory profile.","Paid subscribers of Colab are able to access machines with a high memory system profile subject to availability and your compute unit balance.",
"Note that memory refers to system memory. All GPU chips have the same memory profile."]},f,{hash:"resources",itemTitle:"Why aren't resources guaranteed in Colab?",description:["In order to dynamically offer powerful GPUs at scale for a low price, Colab needs to maintain the flexibility to adjust usage limits and hardware availability dynamically.","In the version of Colab that is free of charge, access to expensive resources like GPUs is heavily restricted. For the paid version of Colab, we target giving our users high value for their spend."]},
d,{hash:"availability",itemTitle:"Where is the paid version of Colab available?",description:["For now, the Colab paid offerings are only available in the following countries: United States of America, Canada, Brazil, France, Germany, India, Japan, Thailand, United Kingdom, Ireland, Israel, Italy, Morocco, Netherlands, Poland, Spain, Switzerland, T\u00fcrkiye, United Arab Emirates, Australia, Bangladesh, Colombia, Hong Kong, Indonesia, Mexico, New Zealand, Pakistan, Philippines, Singapore, Taiwan, Vietnam, Austria, Belgium, Bulgaria, Czech Republic, Denmark, Finland, Greece, Hungary, Portugal, Sweden, Cyprus, Estonia, Croatia, Lithuania, Latvia, Norway, Romania, Slovenia, Slovakia, Algeria, Egypt, Ghana, Kenya, Nigeria, Rwanda, South Africa, Tunisia, Malaysia, Nepal, Saudi Arabia, Sri Lanka, Ukraine, Argentina, Chile, Ecuador, and Peru"]},
g,{hash:"downgrade",itemTitle:h,description:[b]},{hash:"relax",itemTitle:"How can I relax compute limits?",description:["You can purchase a subscription via "+IN+" or "+KN+" which will allocate you compute units every month.","Additionally, everyone can purchase more compute units via "+JN+", even if they have already been granted compute units as part of their subscription.","In order to prevent you from acquiring compute units you may not use, we restrict the purchase of compute units if you already have a substantial compute unit balance."]},
{hash:"ccu",itemTitle:"What are compute units?",description:["Compute units give you the ability to run your notebook on powerful Google Cloud VMs. The amount of access a compute unit gives you depends on the configuration of your VM and use of specialized accelerators like TPUs or GPUs.","Compute units expire after 90 days. Purchase more as you need them."]},{hash:"zero",itemTitle:"What happens when I have zero compute units?",description:["All users can access Colab resources subject to availability. If you have zero compute units you can use Colab to the degree we can support our users who do not pay fees for the service."]},
{hash:"balance",itemTitle:"What is my compute unit balance?",description:["You can view your compute unit balance in the resource monitor."]},{hash:"running-out",itemTitle:"When will I need to purchase more compute units?",description:["We will notify you in Colab when your compute unit balance is running low, and provide you the option to purchase more if you choose.","After your purchase, we may not be able to preserve your current runtime and may assign a fresh one. Please save your work."]},{hash:"ccu",
itemTitle:Zzb,description:["Yes! Subscribing to Colab Pro or Pro+ gives you access to higher RAM runtimes, and in the case of Pro+, access to background execution.","Colab Pro and Pro+ subscriptions will grant you additional compute units every month."]},{hash:"ai-coding-access",itemTitle:"How do I get access to AI coding in Colab?",description:["We are slowly rolling out AI coding features like AI-enabled autocompletions, natural language to code, and a chatbot all based on Gemini.","Users in select locales have access to these features now. Select AI features are available for a limited time for unsubscribed users."]},
{hash:"ai-coding-paid-sub",itemTitle:"I'm a paid subscriber and I don't see AI coding features, what's going on?",description:["Only users in select locales have access to AI coding features. To get access to AI coding features:","Confirm your account age is 18+","AI-enabled autocompletions will appear as you type. Natural language to code and the chatbot both have visible buttons ('generate' and 'Gemini').If you see neither of those, and you've confirmed you should have access, please report feedback in product (\"Help > Send feedback\"). If you want a response via email, you must select the box titled 'We may email you for more information or updates'."]},
{hash:"providers",itemTitle:"What entity provides Colab services?",description:["In the European Economic Area (EEA) and Switzerland, Google services are provided by, and you're contracting with: Google Ireland Limited, incorporated and operating under the laws of Ireland,(Registration Number: 368047 / VAT Number: IE6388047V); Gordon House, Barrow Street, Dublin 4, Ireland.","For applicable remaining countries, Google services are provided by, and you're contracting with: Google LLC, organized under the laws of the State of Delaware, USA, and operating under the laws of the USA; 1600 Amphitheatre Parkway, Mountain View, California 94043, USA. Restrictions apply; please see our terms for further information."]}]}
